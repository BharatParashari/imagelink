# Copy this file to ".env" on the server and fill in real values.
# ".env" is gitignored — never commit it.

# Long random string used to sign session cookies.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Login username.
ADMIN_USER=admin

# Option A (simplest): set a plaintext password here.
ADMIN_PASSWORD=

# Option B (more secure): leave ADMIN_PASSWORD empty and put a bcrypt hash here instead.
# Generate with:  docker compose run --rm backend node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'YourPasswordHere'
ADMIN_PASSWORD_HASH=

# Set to true ONLY after the site is served over HTTPS (otherwise the cookie won't be sent).
COOKIE_SECURE=false
